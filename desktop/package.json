{
  "name": "plume-pc",
  "productName": "Plume",
  "version": "0.5.0",
  "description": "Plume pour PC : notes manuscrites synchronisées avec votre téléphone, sans serveur.",
  "main": "main.js",
  "author": "Plume",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.alinx.plume.pc",
    "productName": "Plume",
    "artifactName": "Plume-PC-Setup.${ext}",
    "files": ["main.js", "hub.js", "web/**/*", "package.json"],
    "win": { "icon": "web/icon-512.png", "target": "nsis" },
    "nsis": {
      "oneClick": true,
      "perMachine": true,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "shortcutName": "Plume",
      "include": "installer.nsh"
    }
  }
}
